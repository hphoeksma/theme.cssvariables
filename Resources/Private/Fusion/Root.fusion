prototype(Neos.Neos:Page) {
  head {
    cssVariables = Neos.Fusion:Component {
      css = ${CssVariables.customCss(site)}
      renderer = afx`<style data-theme-cssvariables>{props.css}</style>`
      renderer.@if.hasCss = ${!String.isBlank(props.css)}
      @position = 'after stylesheets'
    }
  }
}
